# 复制成 server/.env 再改（.env 已被 .gitignore 忽略，不会提交）
# 现在只接本机 Ollama，不需要任何 API key

OLLAMA_ENABLED=1
OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=300

# 说明：
#   OLLAMA_ENABLED=0  就把模型整个关掉，只剩本地正则规则
#   OLLAMA_MODEL      可以换成 `ollama list` 里任何带 tools 能力的模型
#   OLLAMA_TIMEOUT    冷启动要加载 4.4GB 模型，给够时间
