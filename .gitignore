# --- 依赖 ---
node_modules/
.pnpm-store/

# --- 构建产物 ---
dist/
dist-ssr/
*.local

# --- 日志 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 编辑器 ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# *.code-workspace 是「本机多根工作区」配置，里面常带 ../ 这种只在本机存在的路径，
# 提交上去队友打开会看到不存在的根目录（VS Code 报红）。
# 要共享的编辑器设置请写 .vscode/settings.json —— 那个是进仓库的。
*.code-workspace
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 测试 / 缓存 ---
coverage/
.cache/
.vite/

# --- 密钥（永远不提交）---
.env

# --- 提交信息临时文件 ---
# PowerShell 没有 heredoc，只能先写文件再 git commit -F。
# 不忽略的话，git add -A 会把它一起提交上去（踩过一次）。
.commit-msg.tmp

# --- 自动化工具跑出来的产物（不是项目文件）---
# UI 审计脚本/截图/DOM 快照、看图工具的中间结果。
# 这些动辄几十 MB，而且每次跑都会变，不该进仓库。
.ui-audit/
.dsh-vision-router/

.env.*
!.env.example

# --- Python（AI 代理产生的缓存）---
__pycache__/
*.py[cod]
server/*.db
server/*.db-*
